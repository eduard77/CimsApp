@page "/admin/invitations"
@using GeneraPm.Services.Admin
@inject BlazorApiClient Api
@inject ISnackbar Snackbar

<PageHeader Title="Invitations" Subtitle="Active invitations awaiting registration" ShowButton="false" />

@if (_loading) { <Loading /> }
else if (_page == null)
{
    <EmptyState Icon="@Icons.Material.Filled.Lock" Text="Insufficient permissions or service unavailable." />
}
else if (_page.Items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.MailOutline" Text="No active invitations." />
}
else
{
    <MudCard Elevation="0" Style="border-radius:12px;border:1px solid #E2E8F0;overflow:hidden;">
        <MudTable Items="_page.Items" Hover="true" Elevation="0" Dense="true">
            <HeaderContent>
                <MudTh>Organisation</MudTh>
                <MudTh>Email bind</MudTh>
                <MudTh Class="d-none d-sm-table-cell">Type</MudTh>
                <MudTh Class="d-none d-md-table-cell">Created</MudTh>
                <MudTh Class="d-none d-md-table-cell">Created by</MudTh>
                <MudTh Class="d-none d-sm-table-cell">Expires</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.OrganisationName</MudTd>
                <MudTd>@(context.Email ?? "—")</MudTd>
                <MudTd Class="d-none d-sm-table-cell">
                    @if (context.IsBootstrap) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">bootstrap</MudChip> }
                    else { <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">standard</MudChip> }
                </MudTd>
                <MudTd Class="d-none d-md-table-cell"><span style="font-size:12px;color:#64748B;white-space:nowrap;">@context.CreatedAt.ToString("dd MMM HH:mm")</span></MudTd>
                <MudTd Class="d-none d-md-table-cell">@(context.CreatedByName ?? "(anonymous)")</MudTd>
                <MudTd Class="d-none d-sm-table-cell"><span style="font-size:12px;color:#64748B;white-space:nowrap;">@context.ExpiresAt.ToString("dd MMM HH:mm")</span></MudTd>
                <MudTd Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Revoke(context)" Style="text-transform:none;">Revoke</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
        <div style="padding:12px 16px;color:#64748B;font-size:12px;">@_page.Items.Count of @_page.Total</div>
    </MudCard>
}

@code {
    AdminPagedResult<AdminInvitationListItem>? _page;
    bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _page = await Api.AdminListInvitationsAsync();
        _loading = false;
    }

    async Task Revoke(AdminInvitationListItem inv)
    {
        var (ok, err) = await Api.AdminRevokeInvitationAsync(inv.Id);
        if (ok) { Snackbar.Add("Invitation revoked", Severity.Success); await LoadAsync(); }
        else    { Snackbar.Add($"Cannot revoke: {err}", Severity.Error); }
    }
}
