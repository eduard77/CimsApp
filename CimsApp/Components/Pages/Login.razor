@page "/"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Nav

@* ADR-0016 §1 / Decision 4A: static SSR. The form posts to the /login
   minimal API endpoint, which validates credentials, calls SignInAsync
   on the same HTTP request (so the browser sees Set-Cookie), and
   redirects to /dashboard. The "?err=" query string carries the error
   message back here on failed attempts. Plain HTML <input> rather than
   MudTextField because MudTextField does not reliably forward the
   `name` attribute to the underlying input in static-SSR rendering. *@

<div style="min-height:100vh;background:linear-gradient(135deg,#1B2B4B 0%,#1B4F8A 100%);display:flex;align-items:center;justify-content:center;font-family:Inter,Segoe UI,sans-serif;">
    <div style="width:100%;max-width:420px;padding:24px;">
        <div style="text-align:center;margin-bottom:40px;">
            <div style="width:64px;height:64px;background:#F5A623;border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">
                <MudIcon Icon="@Icons.Material.Filled.Domain" Style="color:#1B2B4B;font-size:32px;" />
            </div>
            <h1 style="color:white;font-size:28px;font-weight:700;margin:0;">CIMS</h1>
            <p style="color:rgba(255,255,255,0.5);font-size:12px;margin:4px 0 0;letter-spacing:1px;text-transform:uppercase;">Construction Information Management</p>
        </div>

        <div style="background:#fff;border-radius:16px;padding:36px;box-shadow:0 8px 24px rgba(0,0,0,0.12);">
            <h2 style="font-size:20px;font-weight:600;margin:0 0 4px;color:#1A1F2E;">Sign in</h2>
            <p style="color:#64748B;font-size:14px;margin:0 0 28px;">Enter your credentials to continue</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="margin-bottom:20px;padding:12px 16px;background:#FEE2E2;border:1px solid #FCA5A5;border-radius:8px;color:#991B1B;font-size:14px;">@_error</div>
            }

            <form action="/login" method="post" data-enhance="false">
                <AntiforgeryToken />

                <label style="display:block;font-size:13px;font-weight:500;color:#1A1F2E;margin-bottom:6px;">Email address</label>
                <input name="email" type="email" required autocomplete="email" autofocus
                       style="width:100%;padding:10px 14px;font-size:14px;border:1px solid #CBD5E1;border-radius:8px;margin-bottom:16px;font-family:inherit;" />

                <label style="display:block;font-size:13px;font-weight:500;color:#1A1F2E;margin-bottom:6px;">Password</label>
                <input name="password" type="password" required autocomplete="current-password"
                       style="width:100%;padding:10px 14px;font-size:14px;border:1px solid #CBD5E1;border-radius:8px;margin-bottom:28px;font-family:inherit;" />

                <button type="submit"
                        style="width:100%;height:48px;border:none;border-radius:10px;background:#1B4F8A;color:white;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;">
                    Sign in
                </button>
            </form>
        </div>
        <p style="text-align:center;color:rgba(255,255,255,0.3);font-size:12px;margin-top:24px;">ISO 19650 · PMBOK 7th Edition</p>
    </div>
</div>

@code {
    private string _error = "";

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var qs  = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _error  = qs["err"] ?? "";
    }
}
