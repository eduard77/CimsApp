@page "/admin/users"
@using CimsApp.Models
@using CimsApp.Services.Admin
@inject BlazorApiClient Api
@inject ISnackbar Snackbar

<PageHeader Title="Users" Subtitle="Tenant user administration" ShowButton="false" />

<MudCard Elevation="0" Style="border-radius:12px;border:1px solid #E2E8F0;padding:16px;margin-bottom:16px;">
    <MudTextField @bind-Value="_search" Placeholder="Search by email or name" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnAdornmentClick="LoadAsync" OnKeyUp="OnSearchKey" />
</MudCard>

@if (_loading) { <Loading /> }
else if (_page == null)
{
    <EmptyState Icon="@Icons.Material.Filled.Lock" Text="Insufficient permissions or service unavailable." />
}
else
{
    <MudCard Elevation="0" Style="border-radius:12px;border:1px solid #E2E8F0;overflow:hidden;">
        <MudTable Items="_page.Items" Hover="true" Elevation="0" Dense="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Org</MudTh>
                <MudTh>Global role</MudTh>
                <MudTh>Active</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.FirstName @context.LastName</MudTd>
                <MudTd>@context.OrganisationCode</MudTd>
                <MudTd>
                    <MudSelect T="UserRole?" Value="context.GlobalRole" ValueChanged="r => SetRole(context, r)" Dense="true" Margin="Margin.Dense" Style="min-width:140px;">
                        <MudSelectItem T="UserRole?" Value="@((UserRole?)null)">— (none)</MudSelectItem>
                        <MudSelectItem T="UserRole?" Value="@((UserRole?)UserRole.OrgAdmin)">OrgAdmin</MudSelectItem>
                        <MudSelectItem T="UserRole?" Value="@((UserRole?)UserRole.SuperAdmin)">SuperAdmin</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd>
                    @if (context.IsActive) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">active</MudChip> }
                    else { <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">disabled</MudChip> }
                </MudTd>
                <MudTd Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => RevokeTokens(context)" Style="text-transform:none;">Revoke tokens</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="!context.IsActive" OnClick="() => Deactivate(context)" Style="text-transform:none;">Deactivate</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
        <div style="padding:12px 16px;color:#64748B;font-size:12px;">@_page.Items.Count of @_page.Total</div>
    </MudCard>
}

@code {
    AdminPagedResult<AdminUserListItem>? _page;
    bool _loading = true;
    string _search = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _page = await Api.AdminListUsersAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
        _loading = false;
    }

    async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await LoadAsync(); }

    async Task SetRole(AdminUserListItem u, UserRole? newRole)
    {
        if (u.GlobalRole == newRole) return;
        var (ok, err) = await Api.AdminSetGlobalRoleAsync(u.Id, newRole);
        if (ok) { Snackbar.Add($"Role updated for {u.Email}", Severity.Success); await LoadAsync(); }
        else    { Snackbar.Add($"Cannot set role: {err}", Severity.Error); }
    }

    async Task Deactivate(AdminUserListItem u)
    {
        var (ok, err) = await Api.AdminDeactivateUserAsync(u.Id);
        if (ok) { Snackbar.Add($"Deactivated {u.Email}", Severity.Success); await LoadAsync(); }
        else    { Snackbar.Add($"Cannot deactivate: {err}", Severity.Error); }
    }

    async Task RevokeTokens(AdminUserListItem u)
    {
        var (ok, err) = await Api.AdminRevokeUserTokensAsync(u.Id);
        if (ok) Snackbar.Add($"Tokens revoked for {u.Email}", Severity.Success);
        else    Snackbar.Add($"Cannot revoke: {err}", Severity.Error);
    }
}
