<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CIMS — Construction Information Management</title>
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/cims.css" rel="stylesheet" />
    @* ADR-0016: HeadOutlet enables PageTitle / HeadContent components. *@
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    @* ADR-0016 §3 / Decision 4A: prerender disabled globally; cascading
       auth state is registered via services.AddCascadingAuthenticationState
       in Program.cs (the .NET 8 pattern) so we do not wrap Routes here. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
